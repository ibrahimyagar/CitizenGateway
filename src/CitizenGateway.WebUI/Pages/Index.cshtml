@page
@using CitizenGateway.WebUI.Services
@model IndexModel
@{
    ViewData["Title"] = "Özet";
}

<header class="cg-page-head">
    <div>
        <h1>Vatandaş özeti</h1>
        <p>@DemoLabels.Role(Model.IsPersonel) olarak oturum açıldı · üç birim verisini tek bakışta birleştirir</p>
    </div>
    <div class="cg-meta">
        <span class="cg-pill cg-pill-neutral">@Model.Username</span>
        <partial name="_HealthBadge" model="Model.Health" />
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<partial name="_CitizenQueryForm" model="Model" />

@if (Model.Summary is null)
{
    <div class="cg-card cg-card-pad">
        <p class="cg-empty">Vatandaş seçip sorgulayın. Spor, kütüphane ve çözüm merkezi kayıtları burada görünür.</p>
    </div>
}
else
{
    <partial name="_ServiceSummary" model="Model.Summary" />
    <partial name="_RequestsPanel" model="Model" />
}
